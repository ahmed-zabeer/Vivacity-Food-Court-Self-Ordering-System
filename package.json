  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 server/index.js",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "start": "node --max-old-space-size=4096 server/index.js --production",
