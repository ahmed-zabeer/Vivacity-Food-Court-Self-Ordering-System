# Safe local defaults. Never put credentials or private keys in this file.

# ---- Localhost / LAN ----
PORT=3000
# Base URL used when printing/generating table QR codes. On a laptop this must be
# the LAN address so phones can reach it, e.g. http://192.168.0.197:3000
APP_BASE_URL=http://localhost:3000
VITE_API_BASE_URL=/api

# Comma-separated trusted browser origins. Same-origin requests need no CORS.
CORS_ORIGINS=

# Enable only when HTTPS is enforced by the production deployment.
ENABLE_HSTS=false

# ---- Vercel ----
# The deployed domain, used for QR codes and absolute links (no trailing slash).
# APP_BASE_URL=https://your-app.vercel.app
# VITE_PUBLIC_APP_URL=https://your-app.vercel.app

# Durable order storage. Vercel KV and Upstash Redis both speak the same REST API;
# set either pair. Without these the deployment cannot persist orders.
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=...
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# DATA_KEY_PREFIX=vivacity:data:
