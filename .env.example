# Environment Configuration for Viva City Food Court

# Database
DATABASE_URL="postgresql://vivacity:secret_pass@localhost:5432/vivacity_foodhall?schema=public"

# Authentication
AUTH_SECRET="your-super-secure-jwt-auth-secret-key-32-chars-min"

# bKash Merchant Gateway Credentials
BKASH_API_KEY="bkash_merchant_api_key_sandbox"
BKASH_SECRET="bkash_merchant_secret_key_sandbox"
BKASH_USERNAME="vivacity_merchant"
BKASH_PASSWORD="sandbox_password"
BKASH_BASE_URL="https://tokenized.sandbox.bka.sh/v1.2.0-beta"

# Card / Gateway Credentials (SSLCommerz / Stripe)
PAYMENT_GATEWAY_KEY="pk_live_or_sandbox_merchant_key"
PAYMENT_GATEWAY_SECRET="sk_live_or_sandbox_merchant_secret"

# Public Application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
REALTIME_URL="http://localhost:3000/api/events"
STORAGE_BUCKET="vivacity-media-bucket"

# Demo Mode Toggle (enables realistic simulated gateway flows)
DEMO_MODE=true
